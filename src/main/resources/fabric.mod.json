{
	"schemaVersion": 1,
	"id": "stutterprotection",
	"version": "${version}",
	"name": "StutterProtection",
	"description": "Protecting players when they suffer fps drops.",
	"authors": [
		"minhhjjj"
	],
	"contact": {
		"homepage": "https://github.com/minhhjj5678",
		"sources": "https://github.com/minhhjj5678/Stuttering-Screen-Protection"
	},
	"license": "MIT",
	"icon": "assets/stutterprotection/icon.png",
	"environment": "*",
