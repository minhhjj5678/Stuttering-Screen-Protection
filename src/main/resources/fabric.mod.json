		"main": [
			"com.minhhjjj.stutterprotection.StutterProtection"
		],
		"client": [
			"com.minhhjjj.stutterprotection.StutterProtectionClient"
		]
	},
	"mixins": [
		"stutterprotection.mixins.json",
